{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "host-macos",
            "displayName": "Host macOS (Apple Silicon)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/host-macos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "host-windows",
            "displayName": "Host Windows (MSYS2 UCRT64 GCC)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/host-windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON",
                "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
                "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-macos",
            "configurePreset": "host-macos"
        },
        {
            "name": "host-windows",
            "configurePreset": "host-windows"
        }
    ],
    "testPresets": [
        {
            "name": "host-macos",
            "configurePreset": "host-macos",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "host-windows",
            "configurePreset": "host-windows",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
